# ============================================
# ReForge — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
# Never commit the .env file to version control.
# ============================================

# --- LLM ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- ChromaDB ---
CHROMA_PERSIST_DIR=storage/chromadb
CHROMA_COLLECTION_NAME=reforge_documents

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///storage/reforge.db

# --- Logging ---
LOG_LEVEL=INFO

# --- LangSmith (Optional) ---
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=reforge
